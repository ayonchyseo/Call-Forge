# ── CallForge AI-call backend config (Twilio + OpenAI only) ──────────────────
# Copy this file to server/.env and fill in your values. Nothing else needed.

# --- OpenAI (the AI brain + voice) ---
# Get it from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Twilio (the phone line) ---
# From the Twilio Console dashboard (https://console.twilio.com).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio voice-capable number in E.164 format, e.g. +15551234567
TWILIO_FROM_NUMBER=

# --- Public URL so Twilio can stream audio to this server ---
# Twilio must reach your machine over the internet. For local testing run:
#     ngrok http 8787
# then paste the https URL it prints here (no trailing slash), e.g.
#     PUBLIC_URL=https://abc123.ngrok-free.app
PUBLIC_URL=

# --- Accounts & admin approval ----------------------------------------------
# Durable accounts: a Postgres connection string (Neon/Supabase/Render Postgres).
# WITHOUT this, accounts are stored in server/data/users.json, which is wiped on
# redeploy on hosts like Render. Set this for any real/production deployment.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# Secret used to sign login tokens. Use a long random string in production so
# logins stay valid across restarts.
JWT_SECRET=
# The first admin account (approves everyone else). Change the password!
# If unset, a default admin (admin@callforge.app / changeme123) is created and
# its credentials are printed in the server logs on first boot.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Optional tuning (fast, lowest-cost defaults already set) ---
PORT=8787
# GA Realtime model for the live call. Leave unset to auto-try (most natural first)
# gpt-realtime → gpt-realtime-mini → gpt-4o-realtime-preview. The full gpt-realtime
# sounds the least robotic and supports the newest voices (marin, cedar). Pin one
# model here — e.g. gpt-realtime-mini for the lowest latency/cost.
# OPENAI_REALTIME_MODEL=gpt-realtime

# --- Live-call responsiveness (turn detection / VAD) ---
# Tune how the agent listens. Raise the threshold if the agent gets cut off
# mid-sentence on a noisy/echoey line; lower the silence_ms for even snappier
# replies (too low and it may talk over the prospect).
# VAD_THRESHOLD = speech sensitivity 0..1, HIGHER = less sensitive (default 0.6).
# VAD_SILENCE_MS = pause (ms) before the agent replies; lower = faster (default 400).
# VAD_PREFIX_MS = audio kept before detected speech (default 300).
# VAD_THRESHOLD=0.6
# VAD_SILENCE_MS=400
# VAD_PREFIX_MS=300

# --- Mid-call resilience (keeps a call from going dead partway through) ---
# If the OpenAI realtime socket drops mid-call, the bridge reconnects and resumes
# instead of leaving the prospect in silence. A periodic ping keeps the socket
# alive through quiet stretches so a reconnect is rarely needed.
# OPENAI_MAX_RECONNECTS = mid-call reconnect attempts before giving up (default 3).
# OPENAI_KEEPALIVE_MS = ping interval in ms to hold the socket open (default 20000).
# OPENAI_MAX_RECONNECTS=3
# OPENAI_KEEPALIVE_MS=20000

# --- Transcription / anti-hallucination ---
# Model used to transcribe the prospect's speech. whisper-1 HALLUCINATES text on
# a silent/noisy phone line (invents "thank you", "bye", etc.), which can produce
# a fake transcript and a fake lead from a call where nobody spoke.
# gpt-4o-mini-transcribe hallucinates far less and is the default. Set to
# whisper-1 or gpt-4o-transcribe to override.
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Optional input noise reduction for noisy/echoey lines (cuts false "prospect is
# talking" turns where the agent answers its own echo). Off by default; set to
# far_field (recommended for phone calls) or near_field to enable.
# OPENAI_INPUT_NOISE_REDUCTION=far_field

# Cheap model used once after the call to extract the lead/meeting info.
OPENAI_ANALYSIS_MODEL=gpt-4o-mini
# Default voice the agent speaks with. The newer GA voices marin & cedar sound
# the most human; alloy/echo/shimmer/sage/coral/ash/ballad/verse are also valid.
# The app's ⚙ Settings can override this per call.
OPENAI_VOICE=marin
# Max seconds before an AI call is force-ended and hung up (cost safety net).
CALL_MAX_SECONDS=300

# ── Manual (human) calling ──────────────────────────────────────────────────
# "CALL NOW" can bridge a call through Twilio: it rings YOUR phone (the number
# you set in the app's ⚙ Settings), then dials the client and connects you,
# using TWILIO_FROM_NUMBER as the caller ID. It reuses the Twilio credentials
# above and does NOT need PUBLIC_URL.
# How long the phones ring before giving up.
MANUAL_RING_SECONDS=30
# Max length of a bridged manual conversation (cost safety net).
MANUAL_CALL_MAX_SECONDS=1800
